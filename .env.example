# BunForo configuration — copy to `.env` and edit.
# Bun loads `.env` automatically, so nothing else is required.

# ---- Database ----------------------------------------------------------
# Unset means a local SQLite file, so a fresh clone runs with zero config.
# All three engines are supported by the same code:
#DATABASE_URL=./bunforo.db
#DATABASE_URL=postgres://user:password@localhost:5432/bunforo
#DATABASE_URL=mysql://user:password@localhost:3306/bunforo
# Upgrading an old install: with DATABASE_URL unset, ./buntalk.db is renamed to
# ./bunforo.db automatically on boot. Stop the old process first.

# The schema is created on first boot; there is no migration step to run.

# ---- Uploads -----------------------------------------------------------
# Local disk by default. Files are written to UPLOAD_DIR and served from
# /uploads/<key>, so the public URL never depends on the storage backend —
# which is what makes migrating to S3 a plain file copy.
# On an upgrade a legacy ./uploads directory is moved (or merged) into the
# effective default ./public/assets/uploads on boot (stop the old process first).
#UPLOAD_DIR=./public/assets/uploads
# Images / PDF.
#MAX_UPLOAD_MB=5
# Video uploads and downloads from GitHub Discussions are capped separately.
#MAX_VIDEO_MB=50

# ---- S3-compatible storage --------------------------------------------
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2 and DigitalOcean
# Spaces. Filling in the bucket and credentials is enough: the driver flips
# to s3 on its own. Give a custom endpoint for anything other than AWS.
#S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#S3_REGION=auto
#S3_BUCKET=bunforo
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_SESSION_TOKEN=                      # temporary credentials only

# Set only when the bucket is publicly readable. Left unset, objects are
# served through short-lived presigned URLs instead.
#S3_PUBLIC_URL=https://cdn.example.com
#S3_URL_TTL=3600

# Overrides the auto-detection above. `local` wins even if credentials exist.
#STORAGE_DRIVER=s3

# Migrate existing files:  bun run migrate:s3

# ---- Email (SMTP) ------------------------------------------------------
# Unset means no mail: the client is never built, and email binding stays in
# an unverified-save-only mode. Set SMTP_HOST to enable verification codes
# and password reset. Port 587 uses STARTTLS, 465 uses implicit TLS.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=bot@example.com
#SMTP_PASS=
#SMTP_FROM=BunForo <no-reply@example.com>
#SMTP_SECURE=true                       # override the port-based guess
#SMTP_TLS_REJECT_UNAUTHORIZED=false     # dev only: accept self-signed certs

# Force every signed-in user to bind and verify an email before they can use
# the site. Ignored (with a startup warning) unless SMTP is configured, since
# users could not verify otherwise.
#REQUIRE_EMAIL_BINDING=true

# ---- GitHub -------------------------------------------------------------
# Import Discussions from a repository (CLI only):
#   GITHUB_TOKEN=… GITHUB_REPO=owner/name bun run import:github --dry-run
# A fine-grained token needs Discussions: read; a classic token needs `repo`
# for private repositories. GITHUB_API_BASE is for GitHub Enterprise.
#GITHUB_TOKEN=
#GITHUB_REPO=owner/name
#GITHUB_API_BASE=https://api.github.com

# GitHub OAuth login. The login button appears only when both are set; authors
# of imported posts can claim their placeholder account by signing in here.
# Register the app with callback URL: <your site>/api/auth/github/callback
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
# Needed behind a reverse proxy, where the request origin is not your public URL.
#PUBLIC_BASE_URL=https://forum.example.com

# ---- Server ------------------------------------------------------------
#PORT=3000

# Required when NODE_ENV=production; development falls back to a known
# insecure value. Generate one with: openssl rand -hex 32
#SESSION_SECRET=

# Set to `production` to enable secure (HTTPS-only) session cookies.
# In production, SESSION_SECRET must be set or the server refuses to start.
#NODE_ENV=production
